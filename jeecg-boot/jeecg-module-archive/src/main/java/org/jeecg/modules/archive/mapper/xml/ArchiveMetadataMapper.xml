<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.jeecg.modules.archive.mapper.ArchiveMetadataMapper">

    <update id="restoreById">
        UPDATE archive_metadata SET del_flag = 0 WHERE id = #{id}
    </update>

    <delete id="permanentDeleteById">
        DELETE FROM archive_metadata WHERE id = #{id}
    </delete>

</mapper>
